// This is the Prisma schema for WorkshopHub
// Run `pnpm exec prisma db push` to apply changes
// Run `pnpm exec prisma db seed` to populate with sample data

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TrainingSession {
  id            Int            @id @default(autoincrement())
  title         String
  description   String
  date          DateTime
  capacity      Int
  registered    Int            @default(0)
  location      String
  deliveryMode  String
  status        String         @default("active")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  registrations Registration[]

  @@map("training_sessions")
}

model Registration {
  id        Int             @id @default(autoincrement())
  sessionId Int
  name      String
  email     String
  // confirmed | waitlisted | cancelled (cancelled arrives with WH-4).
  status    String          @default("confirmed")
  createdAt DateTime        @default(now())
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@map("registrations")
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  registrationId Int
  // null for the first entry: the registration did not exist before.
  fromStatus     String?
  toStatus       String
  changedAt      DateTime     @default(now())
  // registered | waitlisted | promoted | cancelled, set by the system.
  reason         String?
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("audit_logs")
}
