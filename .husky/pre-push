#!/usr/bin/env bash
# Husky pre-push hook
# Runs the tests and lint before allowing a push (CLAUDE.md Team Norm 3).

set -euo pipefail

echo "=== Pre-push checks ==="
echo ""

# 1. Tests
echo "--- make test ---"
make test
echo ""

# 2. Lint
echo "--- make lint ---"
make lint

echo ""
echo "=== All pre-push checks passed ==="
